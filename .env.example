# ================= Backend selection =================
# Deploy stack (personal laptop): OpenAI embeddings + Postgres + OpenAI LLM
EMBEDDING_BACKEND=openai
STORE_BACKEND=postgres
LLM_BACKEND=openai
LLM_MODEL=gpt-4o-mini

# Local no-keys stack (optional): comment the lines above and use:
# EMBEDDING_BACKEND=local
# STORE_BACKEND=chroma
# LLM_BACKEND=ollama
# LLM_MODEL=llama3.1
# OLLAMA_HOST=http://localhost:11434

# ================= Credentials =======================
OPENAI_API_KEY=sk-your-key-here
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docsgpt

# Optional: raises GitHub API rate limit when pulling issues
GITHUB_TOKEN=ghp_your-token-here

# ================= Caching (optional) ================
# Unset REDIS_URL -> in-process cache. Set it to use Redis.
# REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL=86400

# ================= Tracing (optional) ================
# Set both keys to enable Langfuse tracing of /ask requests.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
